# Claude Code host environment for codex-grok-mcp.
#
# Claude Code defaults for MCP timeouts are far below grok_implement's
# 30-minute server default. Raise them (ms) to mirror Codex tool_timeout_sec=2400.
#
# Register the server (once):
#   claude mcp add codex-grok -s user -- node /ABSOLUTE/PATH/TO/GPTtoGrok/dist/index.js
#   # -s user  → every project on this machine
#   # -s local → current project only
#
# After npm run build, restart Claude Code / reconnect the MCP server so dist/ reloads.

export MCP_TOOL_TIMEOUT=2400000   # 40 minutes per tool call
export MCP_TIMEOUT=30000          # server startup / connect
