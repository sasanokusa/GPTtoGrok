# Claude Code host environment for codex-grok-mcp.
#
# Claude Code defaults for MCP timeouts are far below grok_implement's
# 30-minute server default. Raise them (ms) to mirror Codex tool_timeout_sec=2400.
#
# Register the server (once):
#   claude mcp add codex-grok -s user -- node /ABSOLUTE/PATH/TO/GPTtoGrok/dist/index.js
#   # -s user  → every project on this machine
#   # -s local → current project only
#
# After npm run build, restart Claude Code / reconnect the MCP server so dist/ reloads.

export MCP_TOOL_TIMEOUT=2400000   # 40 minutes per tool call
export MCP_TIMEOUT=30000          # server startup / connect

# Optional: shrink MCP responses for large Grok diffs (response_mode="auto").
# Diffs above this many bytes come back compact, with the redacted patch written
# to diff_artifact_path under ~/.cache/codex-grok-mcp/diffs instead of inline.
# export GROK_MCP_INLINE_DIFF_MAX_BYTES=65536
# Absolute inline ceiling, applied even to response_mode="full".
# export GROK_MCP_INLINE_DIFF_HARD_MAX_BYTES=1048576
# Opt-in cap on the patch itself. Default 0 = unlimited: an oversized diff is
# moved to an artifact whole, never cut. Set a non-zero value only if you want
# truncation; the result then reports diff_truncated / original_diff_bytes and
# diff_complete=false, and the patch must not be applied directly.
# export GROK_MCP_MAX_DIFF_BYTES=0
